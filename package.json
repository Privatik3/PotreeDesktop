{
	"name": "potree_desktop",
	"version": "1.7.0",
	"description": "A WebGL Point Cloud Viewer",
	"main": "main.js",
	"scripts": {
		"start": "electron .",
		"potree:install": "npm --prefix potree install",
		"potree:build": "npm --prefix potree run build",
		"potree:sync": "node scripts/sync-potree.js",
		"potree:deploy": "npm run potree:build && npm run potree:sync"
	},
	"repository": "https://github.com/potree/potree",
	"keywords": [
		"Potree",
		"point cloud viewer",
		"lidar viewer"
	],
	"author": "Markus Schuetz",
	"license": "no license available at this time",
	"dependencies": {
		"electron": "21.3.1"
	}
}
